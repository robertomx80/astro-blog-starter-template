---
import Layout from "../layouts/Base.astro";
import ProjectCard from "../components/ProjectCard.astro";
import FormattedDate from "../components/FormattedDate.astro";
import SocialIcon from "../components/SocialIcon.astro";
import { getCollection } from "astro:content";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { profile, projects, stats, skills, socials } from "../site.config";

const featured = projects.filter((p) => p.featured).slice(0, 2);

const posts = (await getCollection("blog"))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
---

<Layout title={SITE_TITLE} description={SITE_DESCRIPTION}>
	<!-- ── Hero ─────────────────────────────────────────── -->
	<section class="hero">
		<div class="hero-text">
			{
				profile.available && (
					<p class="status">
						<span class="dot" aria-hidden="true" />
						Disponible para proyectos
					</p>
				)
			}

			<h1>{profile.name}</h1>
			<p class="role">{profile.role} · {profile.location}</p>
			<p class="tagline">{profile.tagline}</p>

			<div class="actions">
				<a class="btn primary" href={`mailto:${profile.email}`}>Escríbeme</a>
				<a class="btn" href="/proyectos">Ver proyectos</a>
				{
					profile.resume && (
						<a class="btn" href={profile.resume} target="_blank" rel="noopener noreferrer">
							Descargar CV
						</a>
					)
				}
			</div>

			<div class="hero-socials">
				{
					socials.map((s) => (
						<a href={s.url} target="_blank" rel="noopener noreferrer" title={s.name}>
							<span class="sr-only">{s.name}</span>
							<SocialIcon icon={s.icon} size={18} />
						</a>
					))
				}
			</div>
		</div>

		<div class="avatar" aria-hidden={profile.avatar ? undefined : "true"}>
			{
				profile.avatar ? (
					<img src={profile.avatar} alt={profile.name} width="220" height="220" />
				) : (
					<span>{profile.initials}</span>
				)
			}
		</div>
	</section>

	<!-- ── Métricas ─────────────────────────────────────── -->
	<section class="stats">
		{
			stats.map((s) => (
				<div class="stat">
					<span class="value">{s.value}</span>
					<span class="label">{s.label}</span>
				</div>
			))
		}
	</section>

	<!-- ── Proyectos destacados ─────────────────────────── -->
	<section class="block">
		<div class="block-head">
			<div>
				<span class="section-label">Trabajo</span>
				<h2>Proyectos destacados</h2>
			</div>
			<a class="more" href="/proyectos">Ver todos &rarr;</a>
		</div>

		<div class="grid">
			{featured.map((p) => <ProjectCard {...p} />)}
		</div>
	</section>

	<!-- ── Skills ───────────────────────────────────────── -->
	<section class="block">
		<span class="section-label">Stack</span>
		<h2>Con qué trabajo</h2>

		<div class="skills">
			{
				skills.map((g) => (
					<div class="skill-group">
						<h3>{g.group}</h3>
						<ul>
							{g.items.map((i) => (
								<li>{i}</li>
							))}
						</ul>
					</div>
				))
			}
		</div>
	</section>

	<!-- ── Últimos posts ────────────────────────────────── -->
	{
		posts.length > 0 && (
			<section class="block">
				<div class="block-head">
					<div>
						<span class="section-label">Escritos</span>
						<h2>Del blog</h2>
					</div>
					<a class="more" href="/blog">
						Ver todos &rarr;
					</a>
				</div>

				<ul class="posts">
					{posts.map((post) => (
						<li>
							<a href={`/blog/${post.id}/`}>
								<span class="post-date">
									<FormattedDate date={post.data.pubDate} />
								</span>
								<span class="post-title">{post.data.title}</span>
								<span class="post-desc">{post.data.description}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}

	<!-- ── CTA ──────────────────────────────────────────── -->
	<section class="cta">
		<h2>¿Trabajamos juntos?</h2>
		<p>Cuéntame qué tienes en mente. Respondo en menos de 24 horas.</p>
		<a class="btn primary" href={`mailto:${profile.email}`}>{profile.email}</a>
	</section>
</Layout>

<style>
	/* ── Hero ── */
	.hero {
		display: grid;
		grid-template-columns: 1fr auto;
		align-items: center;
		gap: 3rem;
		padding: 2rem 0 4rem;
	}

	.status {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		margin: 0 0 1.25rem;
		padding: 0.25rem 0.7rem;
		border: 1px solid var(--border-strong);
		border-radius: 999px;
		background: var(--bg-subtle);
		font-size: 0.78rem;
		color: var(--text-muted);
	}

	.dot {
		width: 7px;
		height: 7px;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 0 3px rgba(74, 222, 128, 0.18);
	}

	h1 {
		margin-bottom: 0.4rem;
	}

	.role {
		margin: 0 0 1rem;
		font-family: var(--font-mono);
		font-size: 0.88rem;
		color: var(--accent);
	}

	.tagline {
		max-width: 34rem;
		font-size: 1.05rem;
		margin-bottom: 1.75rem;
	}

	.actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.65rem;
	}

	.btn {
		display: inline-block;
		padding: 0.6rem 1.15rem;
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-sm);
		background: var(--bg-subtle);
		color: var(--text);
		font-size: 0.9rem;
		font-weight: 500;
		text-decoration: none;
		transition:
			background 0.18s ease,
			border-color 0.18s ease,
			transform 0.18s ease;
	}

	.btn:hover {
		background: var(--bg-elevated);
		border-color: var(--text-faint);
		color: var(--text);
		transform: translateY(-1px);
	}

	.btn.primary {
		background: var(--accent);
		border-color: var(--accent);
		color: #0a0a0b;
		font-weight: 600;
	}

	.btn.primary:hover {
		background: #a3bbff;
		border-color: #a3bbff;
		color: #0a0a0b;
	}

	.hero-socials {
		display: flex;
		gap: 0.4rem;
		margin-top: 1.75rem;
	}

	.hero-socials a {
		display: grid;
		place-items: center;
		width: 36px;
		height: 36px;
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		color: var(--text-faint);
		transition:
			color 0.18s ease,
			border-color 0.18s ease;
	}

	.hero-socials a:hover {
		color: var(--accent);
		border-color: var(--border-strong);
	}

	.avatar {
		width: 200px;
		height: 200px;
		flex-shrink: 0;
		display: grid;
		place-items: center;
		border-radius: 50%;
		border: 1px solid var(--border-strong);
		background: radial-gradient(circle at 30% 25%, var(--accent-soft), var(--bg-elevated) 70%);
		font-size: 3.5rem;
		font-weight: 600;
		letter-spacing: -0.03em;
		color: var(--accent);
		overflow: hidden;
	}

	.avatar img {
		width: 100%;
		height: 100%;
		object-fit: cover;
		border-radius: 50%;
	}

	/* ── Métricas ── */
	.stats {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1px;
		background: var(--border);
		border: 1px solid var(--border);
		border-radius: var(--radius);
		overflow: hidden;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.2rem;
		padding: 1.4rem 1.5rem;
		background: var(--bg-elevated);
	}

	.value {
		font-size: 1.85rem;
		font-weight: 650;
		letter-spacing: -0.03em;
	}

	.label {
		font-size: 0.82rem;
		color: var(--text-faint);
	}

	/* ── Bloques ── */
	.block {
		padding-top: 5rem;
	}

	.block-head {
		display: flex;
		align-items: flex-end;
		justify-content: space-between;
		gap: 1rem;
		margin-bottom: 1.75rem;
	}

	.block h2 {
		margin: 0;
	}

	.more {
		flex-shrink: 0;
		font-size: 0.88rem;
		text-decoration: none;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
		gap: 1rem;
	}

	/* ── Skills ── */
	.skills {
		display: grid;
		grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
		gap: 1.5rem;
		margin-top: 1.75rem;
	}

	.skill-group h3 {
		margin: 0 0 0.75rem;
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.1em;
		text-transform: uppercase;
		color: var(--text-faint);
	}

	.skill-group ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-direction: column;
		gap: 0.4rem;
	}

	.skill-group li {
		font-size: 0.925rem;
		color: var(--text-muted);
	}

	/* ── Posts ── */
	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}

	.posts a {
		display: grid;
		grid-template-columns: 7.5rem 1fr;
		gap: 0.25rem 1.5rem;
		padding: 1.15rem 0.75rem;
		margin: 0 -0.75rem;
		border-bottom: 1px solid var(--border);
		border-radius: var(--radius-sm);
		text-decoration: none;
		transition: background 0.18s ease;
	}

	.posts a:hover {
		background: var(--bg-elevated);
	}

	.post-date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-faint);
		padding-top: 0.2rem;
	}

	.post-title {
		font-size: 1.02rem;
		font-weight: 550;
		color: var(--text);
	}

	.posts a:hover .post-title {
		color: var(--accent);
	}

	.post-desc {
		grid-column: 2;
		font-size: 0.88rem;
		color: var(--text-faint);
		display: -webkit-box;
		-webkit-line-clamp: 1;
		line-clamp: 1;
		-webkit-box-orient: vertical;
		overflow: hidden;
	}

	/* ── CTA ── */
	.cta {
		margin-top: 5rem;
		padding: 3.5rem 2rem;
		text-align: center;
		border: 1px solid var(--border);
		border-radius: var(--radius);
		background:
			radial-gradient(ellipse 60% 100% at 50% 0%, var(--accent-soft), transparent 70%),
			var(--bg-elevated);
	}

	.cta h2 {
		margin-bottom: 0.5rem;
	}

	.cta p {
		margin-bottom: 1.5rem;
	}

	/* ── Responsive ── */
	@media (max-width: 820px) {
		.hero {
			grid-template-columns: 1fr;
			gap: 2rem;
			padding-bottom: 3rem;
		}
		.avatar {
			order: -1;
			width: 130px;
			height: 130px;
			font-size: 2.4rem;
		}
	}

	@media (max-width: 620px) {
		.stats {
			grid-template-columns: 1fr;
		}
		.block {
			padding-top: 3.5rem;
		}
		.posts a {
			grid-template-columns: 1fr;
		}
		.post-desc {
			grid-column: 1;
		}
	}
</style>
