---
import Layout from "../../layouts/Base.astro";
import FormattedDate from "../../components/FormattedDate.astro";
import { getCollection } from "astro:content";
import { profile } from "../../site.config";

const posts = (await getCollection("blog")).sort(
	(a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf(),
);
---

<Layout
	title={`Blog · ${profile.name}`}
	description={`Artículos y notas técnicas de ${profile.name}.`}
>
	<header class="page-head">
		<span class="section-label">Escritos</span>
		<h1>Blog</h1>
		<p>Notas sobre desarrollo, arquitectura y las decisiones detrás de lo que construyo.</p>
	</header>

	<ul class="posts">
		{
			posts.map((post) => (
				<li>
					<a href={`/blog/${post.id}/`}>
						<span class="date">
							<FormattedDate date={post.data.pubDate} />
						</span>
						<div class="body">
							<h2>{post.data.title}</h2>
							<p>{post.data.description}</p>
						</div>
					</a>
				</li>
			))
		}
	</ul>

	{posts.length === 0 && <p class="empty">Todavía no hay publicaciones.</p>}
</Layout>

<style>
	.page-head {
		max-width: var(--prose-width);
		margin-bottom: 3rem;
	}

	.page-head h1 {
		font-size: clamp(2rem, 5vw, 2.8rem);
		margin-bottom: 0.75rem;
	}

	.posts {
		list-style: none;
		margin: 0;
		padding: 0;
		border-top: 1px solid var(--border);
	}

	.posts a {
		display: grid;
		grid-template-columns: 8rem 1fr;
		gap: 1.5rem;
		padding: 1.6rem 1rem;
		margin: 0 -1rem;
		border-bottom: 1px solid var(--border);
		border-radius: var(--radius-sm);
		text-decoration: none;
		transition: background 0.18s ease;
	}

	.posts a:hover {
		background: var(--bg-elevated);
	}

	.date {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-faint);
		padding-top: 0.35rem;
	}

	.body h2 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
		font-weight: 600;
		color: var(--text);
	}

	.posts a:hover .body h2 {
		color: var(--accent);
	}

	.body p {
		margin: 0;
		font-size: 0.92rem;
		color: var(--text-muted);
	}

	.empty {
		color: var(--text-faint);
	}

	@media (max-width: 620px) {
		.posts a {
			grid-template-columns: 1fr;
			gap: 0.4rem;
		}
		.date {
			padding-top: 0;
		}
	}
</style>
