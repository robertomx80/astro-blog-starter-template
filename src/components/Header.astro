---
import HeaderLink from "./HeaderLink.astro";
import SocialIcon from "./SocialIcon.astro";
import { profile, socials } from "../site.config";
---

<header>
	<nav>
		<a class="brand" href="/">
			<span class="mark">{profile.initials}</span>
			<span class="brand-name">{profile.name}</span>
		</a>

		<div class="links">
			<HeaderLink href="/">Inicio</HeaderLink>
			<HeaderLink href="/proyectos">Proyectos</HeaderLink>
			<HeaderLink href="/sobre-mi">Sobre mí</HeaderLink>
			<HeaderLink href="/blog">Blog</HeaderLink>
		</div>

		<div class="socials">
			{
				socials.map((s) => (
					<a href={s.url} target="_blank" rel="noopener noreferrer">
						<span class="sr-only">{s.name}</span>
						<SocialIcon icon={s.icon} size={17} />
					</a>
				))
			}
		</div>
	</nav>
</header>

<style>
	header {
		position: sticky;
		top: 0;
		z-index: 50;
		border-bottom: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg) 78%, transparent);
		backdrop-filter: saturate(180%) blur(14px);
		-webkit-backdrop-filter: saturate(180%) blur(14px);
	}

	nav {
		width: var(--content-width);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		height: 60px;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1.5rem;
	}

	.brand {
		display: flex;
		align-items: center;
		gap: 0.6rem;
		text-decoration: none;
		color: var(--text);
		font-weight: 600;
		font-size: 0.95rem;
		letter-spacing: -0.01em;
		white-space: nowrap;
	}

	.mark {
		display: grid;
		place-items: center;
		width: 28px;
		height: 28px;
		border-radius: 8px;
		border: 1px solid var(--border-strong);
		background: var(--accent-soft);
		color: var(--accent);
		font-family: var(--font-mono);
		font-size: 0.7rem;
		font-weight: 600;
		letter-spacing: 0.02em;
	}

	.links {
		display: flex;
		gap: 0.35rem;
	}

	.socials {
		display: flex;
		gap: 0.15rem;
	}

	.socials a {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: var(--radius-sm);
		color: var(--text-faint);
		transition:
			color 0.18s ease,
			background 0.18s ease;
	}

	.socials a:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}

	@media (max-width: 820px) {
		.brand-name {
			display: none;
		}
	}

	@media (max-width: 620px) {
		.socials {
			display: none;
		}
		nav {
			gap: 0.75rem;
		}
	}
</style>
