---
import SocialIcon from "./SocialIcon.astro";
import { profile, socials } from "../site.config";

const year = new Date().getFullYear();
---

<footer>
	<div class="inner">
		<p class="copy">&copy; {year} {profile.name}. Hecho con Astro.</p>

		<div class="socials">
			{
				socials.map((s) => (
					<a href={s.url} target="_blank" rel="noopener noreferrer">
						<span class="sr-only">{s.name}</span>
						<SocialIcon icon={s.icon} size={17} />
					</a>
				))
			}
			<a href="/rss.xml">
				<span class="sr-only">RSS</span>
				<SocialIcon icon="rss" size={17} />
			</a>
		</div>
	</div>
</footer>

<style>
	footer {
		border-top: 1px solid var(--border);
		margin-top: auto;
	}

	.inner {
		width: var(--content-width);
		max-width: calc(100% - 2.5rem);
		margin: 0 auto;
		padding: 1.75rem 0;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.copy {
		margin: 0;
		font-size: 0.85rem;
		color: var(--text-faint);
	}

	.socials {
		display: flex;
		gap: 0.15rem;
	}

	.socials a {
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		border-radius: var(--radius-sm);
		color: var(--text-faint);
		transition:
			color 0.18s ease,
			background 0.18s ease;
	}

	.socials a:hover {
		color: var(--text);
		background: var(--bg-subtle);
	}

	@media (max-width: 620px) {
		.inner {
			flex-direction: column;
			text-align: center;
		}
	}
</style>
